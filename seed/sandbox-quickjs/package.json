{
  "name": "ursitoare-sandbox-quickjs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "M7: QuickJS-in-Wasm code-node sandbox spike",
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.ts",
