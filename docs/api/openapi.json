{
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "type": "string"
              },
              "details": {},
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Ursitoare API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/me": {
      "get": {
        "operationId": "get_api_v1_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "capabilities": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "csrfToken": {
                      "type": "string"
                    },
                    "tenant": {
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "reviewProfile": {
                          "enum": [
                            "solo",
                            "team"
                          ],
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "reviewProfile"
                      ],
                      "type": "object"
                    },
                    "user": {
                      "additionalProperties": false,
                      "properties": {
                        "displayName": {
                          "type": "string"
                        },
                        "email": {
                          "type": [
                            "null",
                            "string"
                          ]
                        },
                        "id": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "displayName",
                        "email"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "user",
                    "tenant",
                    "capabilities",
                    "csrfToken"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Success"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error codes: UNAUTHENTICATED"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error codes: FORBIDDEN"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error codes: AUTHZ_UNAVAILABLE"
          }
        },
        "x-ursitoare-action": "read_self",
        "x-ursitoare-auth": "session",
        "x-ursitoare-errors": [
          "AUTHZ_UNAVAILABLE",
          "FORBIDDEN",
          "UNAUTHENTICATED"
        ]
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "operationId": "get_api_v1_openapi_json",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "x-ursitoare-auth": "public:static",
        "x-ursitoare-errors": []
      }
    },
    "/auth/oidc/callback": {
      "get": {
        "operationId": "get_auth_oidc_callback",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "x-ursitoare-auth": "public:oidc",
        "x-ursitoare-errors": []
      }
    },
    "/auth/oidc/login": {
      "get": {
        "operationId": "get_auth_oidc_login",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "x-ursitoare-auth": "public:oidc",
        "x-ursitoare-errors": []
      }
    },
    "/auth/oidc/logout": {
      "post": {
        "operationId": "post_auth_oidc_logout",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "x-ursitoare-auth": "public:oidc",
        "x-ursitoare-errors": []
      }
    },
    "/health": {
      "get": {
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "x-ursitoare-auth": "public:health",
        "x-ursitoare-errors": []
      }
    }
  }
}
