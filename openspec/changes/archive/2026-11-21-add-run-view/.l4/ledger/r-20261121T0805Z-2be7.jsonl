claim": "The queue's default limit is PREVIEW_CONCURRENCY, which is 4."}, {"ref": "web/src/runs/run-view.ts:130", "quote": "while (inFlight < limit && waiting.length > 0) {", "claim": "The queue starts a ref only while fewer than limit are in flight."}, {"ref": "web/src/runs/RunPage.tsx:175", "quote": "const previewKey = previewRefs(steps).join(\",\");", "claim": "The page enqueues the preview refs of the first 50 steps."}, {"ref": "web/src/runs/preview-queue.test.ts:80", "quote": "assert.equal(w.maxInFlight(), 4);", "claim": "A Node test asserts a maximum of four in flight."}, {"ref": "web/src/runs/run-view.test.ts:447", "quote": "assert.equal(r4[50]?.preview, null);", "claim": "A Node test asserts the 51st step has no preview."}, {"ref": "AGENTS.md:95", "quote": "leave a criterion that only browser tests check out of", "claim": "The project's rules leave browser-only criteria to the verifier, so no red record exists by design."}]}
