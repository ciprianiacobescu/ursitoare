{"ts": "2026-11-08T17:42:24.911408Z", "run_id": "r-20261108T1736Z-164d", "unit": "openspec:add-hook-taint-check", "seq": 15, "type": "held.replayed", "question": "Q-001", "task": "2.1", "check": "pre_satisfied", "patch_sha256": "02c6c765fd70432cfb78d6c9267f9a59d00a39d431f8adbbd544b62ec49a88cd", "tests": ["src.authoring.validate.hook-taint.test.ts::C-4f58ed6e hook edges that stay allowed give no taint error"], "sources": {"src.authoring.validate.hook-taint.test.ts::C-4f58ed6e hook edges that stay allowed give no taint error": "test(\"C-4f58ed6e hook edges that stay allowed give no taint error\", () => {\n  const edits: Array<(d: Doc) => void> = [\n    (d) => {\n      node(d, \"send\").pre = [\n        { id: \"peek\", kind: \"code\", source: \"return;\", input: { raw: \"${{ nodes.fetch.output.content }}\" } },\n      ];\n    },\n    (d) => {\n      node(d, \"extract\").pre = [\n        { id: \"look\", kind: \"block\", uses: \"kb.search@1\", with: { query: \"${{ nodes.fetch.output.content }}\" } },\n      ];\n    },\n    (d) => {\n      node(d, \"send\").pre = [\n        { id: \"note\", kind: \"block\", uses: \"mail.send@1\", with: mail(\"${{ nodes.extract.output.summary }}\") },\n      ];\n    },\n    (d) => {\n      node(d, \"extract\").pre = [\n        { id: \"ghost\", kind: \"block\", uses: \"nope.tool@1\", with: { x: \"${{ nodes.fetch.output.content }}\" } },\n      ];\n    },\n    (d) => {\n      node(d, \"fetch\").post = [\n        {\n          id: \"tell\",\n          kind: \"block\",\n          uses: \"slack.post_message@1\",\n          with: { channel: \"#ap\", text: \"${{ hook.node.id }}\" },\n        },\n      ];\n    },\n  ];\n  const results = edits.map((e) => check(e));\n  for (const r of results) {\n    assert.deepEqual(l3(r), []);\n    assert.deepEqual(r.layers_run, [\"L1\", \"L2\", \"L3\", \"H\"]);\n  }\n  for (const i of [0, 1, 2, 4]) {\n    assert.equal(results[i]?.ok, true, `N${i + 1}`);\n[cut: 9 more lines]"}, "phase": "red", "attempt": 1}
