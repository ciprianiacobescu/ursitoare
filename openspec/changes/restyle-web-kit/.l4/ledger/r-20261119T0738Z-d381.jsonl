anceof HTMLElement && opener.isConnected) {", "claim": "The close handler returns focus to the stored opener after Escape."}, {"ref": "web/src/kit/theme.css:130", "quote": ".ui-dialog {\n  width: 32rem;\n  max-width: calc(100vw - 2rem);", "claim": "The dialog is 512 px wide at 1366 and bounded by the viewport."}, {"ref": "web/src/styles/app.css:53", "quote": "dialog { margin: auto; }", "claim": "The native dialog is centred."}, {"ref": "web/src/kit/theme.css:36", "quote": ".ui-button[data-tone=\"primary\"] {\n  border-color: var(--ui-color-accent);\n  background: var(--ui-color-accent);", "claim": "The primary confirm button's background is the accent token the test resolves at run time."}, {"ref": "web/src/kit/theme.css:20", "quote": "background: var(--ui-color-surface);", "claim": "The quiet Cancel button's background is the surface token."}, {"ref": "web/src/admin/UsersPage.tsx:139", "quote": "<ConfirmDialog\n          open\n          title={pendingAction.confirm.title}", "claim": "The Users page passes no destructive prop, so Disable user takes the primary tone."}, {"ref": "web/src/admin/users.ts:123", "quote": "action: \"Disable user\",", "claim": "The confirm button of the disable dialog is named Disable user."}, {"ref": "web/src/kit/tokens.css:8", "quote": "--ui-color-accent: #1d4ed8;", "claim": "The accent token resolves to rgb(29, 78, 216) as the scenario states for primary."}]}
