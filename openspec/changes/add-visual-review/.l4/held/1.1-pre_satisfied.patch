+    expect(page.get_by_role("button", name="Approve surface", exact=True)).to_be_visible()
+
+
+def ready_grants(page: Page) -> None:
+    expect(page.get_by_text("No grants", exact=True)).to_be_visible()
+    expect(page.get_by_label("Tool", exact=True)).to_be_visible()
