+@pytest.mark.milestone("M6b")
+@pytest.mark.l4("C-f417704e", "C-54891f4b")
+def test_signed_out_pages_are_styled(page: Page, fresh_state: None) -> None:
+    visual = open_visual(page, "signed-out", WIDE)
+
+    page.goto("/")
