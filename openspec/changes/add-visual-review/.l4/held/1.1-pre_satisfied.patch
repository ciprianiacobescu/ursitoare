+@pytest.mark.milestone("M6b")
+@pytest.mark.l4("C-0462bba1", "C-1beceb27", "C-de5dc745")
+def test_alice_builds_tests_and_reads_a_flow(
+    page: Page, fresh_state: None, users: dict[str, dict[str, str]]
+) -> None:
