+def ready_roles_teams(page: Page) -> None:
+    expect(
+        page.get_by_role("table", name="Roles", exact=True)
+        .get_by_role("row")
+        .filter(has_text="tenant_admin")
+        .first
+    ).to_be_visible()
+    expect(
+        page.get_by_role("table", name="Teams", exact=True)
+        .get_by_role("row")
+        .filter(has_text="finance")
+        .first
+    ).to_be_visible()
+
+
+def ready_mappings(page: Page) -> None:
+    expect(
+        page.get_by_role("table", name="Group mappings", exact=True)
+        .get_by_role("row")
+        .filter(has_text="ursitoare-authors")
+        .first
+    ).to_be_visible()
+
+
+def ready_audit(page: Page) -> None:
+    expect(
+        region(page, "Chain verification").get_by_role("status")
+    ).to_contain_text("Audit chain verified")
+    expect(
+        page.get_by_role("table", name="Audit events", exact=True)
+        .get_by_role("row")
+        .filter(has_text="identity.team_created")
+        .first
+    ).to_be_visible()
+
+
+def ready_tool_servers(page: Page) -> None:
