+
+
+def ready_home_after(run_id: str):
+    def ready(page: Page) -> None:
+        expect(page.get_by_role("status")).to_have_text("Engine healthy")
+        expect(region(page, "Recent runs")).to_contain_text(
+            f"Run {run_id[-8:]} of demo-ui"
+        )
+        expect(
+            region(page, "Recent flows").get_by_role(
+                "link", name="demo-ui", exact=True
+            )
+        ).to_be_visible()
+        expect(region(page, "Next steps")).to_contain_text("Start a test run")
+
+    return ready
+
+
+def ready_graph(page: Page) -> None:
+    expect(
+        region(page, "Graph").get_by_text(
+            "Flow graph: 5 nodes, 4 edges, 4 layers.", exact=True
+        )
+    ).to_be_visible()
+
+
+def ready_carol_home(page: Page) -> None:
+    expect(region(page, "Recent runs")).to_contain_text("No runs yet")
+    expect(region(page, "Next steps")).to_contain_text("Review pending tool servers")
+
+
+def ready_carol_narrow(page: Page) -> None:
+    expect(
+        page.get_by_role("navigation", name="Main", exact=True).get_by_role(
+            "link", name="Audit log", exact=True
+        )
+    ).to_be_visible()
+
+
