+    page.get_by_role("button", name="Validate", exact=True).click()
+    expect(region(page, "Diagnostics")).to_contain_text("Valid. 0 errors")
+    expect(
+        region(page, "Graph").get_by_role(
+            "link", name="Open the graph on its own page", exact=True
+        )
