+    )
+    visual.loaded(ready_run)
+    visual.settle()
+    page.keyboard.press("Escape")
+    expect(page.get_by_role("tooltip")).to_have_count(0)
+    visual.shoot("/runs/{run_id}")
+
+    nav.get_by_role("link", name="Runs", exact=True).click()
+    row = (
+        page.get_by_role("table", name="Runs", exact=True)
+        .get_by_role("row")
+        .filter(has_text="demo-ui")
+    )
+    expect(row).to_contain_text("completed")
+    expect(row).to_contain_text("Alice Example")
+    expect(row).to_contain_text("<1 s")
+    visual.check("/runs", ready_runs)
+
+    nav.get_by_role("link", name="Home", exact=True).click()
+    expect(region(page, "Recent runs")).to_contain_text(
+        f"Run {run_id[-8:]} of demo-ui"
