+"""The M6b closing journey: every page of every role, checked and photographed."""
+
+import json
+import os
+import re
+import struct
+from pathlib import Path
+
+import pytest
+from playwright.sync_api import Page, expect
+
+from conftest import assert_accessible, assert_layout, login, watch_csp
+
+WIDE = {"width": 1366, "height": 860}
+NARROW = {"width": 900, "height": 800}
+MAX_BANNER_PX = 72
+MAX_FLOW_PAGE_PX = 3000
+REPO_ROOT = Path(__file__).resolve().parent.parent
+VISUAL_DIR = Path(os.environ.get("E2E_VISUAL_DIR") or REPO_ROOT / ".l4-out" / "visual")
+
+DEMO_UI = "\n".join(
+    [
+        'ursitoare: "0.1"',
+        "flow: demo-ui",
+        "version: 1.0.0",
+        "inputs:",
+        "  type: object",
+        "  properties:",
+        "    vendor_name: { type: string }",
+        "    amount: { type: number }",
+        "  required: [vendor_name, amount]",
+        "start: lookup",
+        "nodes:",
+        '  lookup: { kind: block, uses: erp.lookup_vendor@1, with: { vendor_name: "${{ inputs.vendor_name }}" }, next: route }',
+        '  route: { kind: switch, on: "${{ nodes.lookup.output.status }}", cases: { active: pay }, default: blocked }',
+        "  pay:",
+        "    kind: block",
+        "    uses: erp.create_payment@1",
+        '    with: { vendor_id: "${{ nodes.lookup.output.vendor_id }}", amount: "${{ inputs.amount }}", currency: EUR, reference: demo }',
+        "    next: done",
+        '  done: { kind: end, status: completed, output: { payment_id: "${{ nodes.pay.output.payment_id }}" } }',
+        "  blocked: { kind: end, status: failed }",
+        "",
+    ]
+)
+LOOKUP_OUTPUT = '{"vendor_id":"V-1","status":"active"}'
+PAY_OUTPUT = '{"payment_id":"P-1","status":"created"}'
+PREVIEWS = [json.loads(LOOKUP_OUTPUT), json.loads(PAY_OUTPUT), {"payment_id": "P-1"}]
+LINK_NAME = re.compile(r"^Open run [A-Za-z0-9_-]+$")
+LOADING = re.compile(r"^\s*(Loading|Checking)")
+
+VISUAL_PAGES: dict[str, list[str]] = {
+    "signed-out": ["/", "/sign-in", "/no-such-page"],
+    "alice": ["/", "/flows", "/flows/demo-ui", "/runs/{run_id}", "/runs", "/flows/demo-ui/graph"],
+    "carol": ["/", "/admin/users", "/admin/roles-and-teams", "/admin/group-mappings", "/admin/audit",
+              "/admin/tool-servers", "/admin/tool-servers?server=acme", "/admin/grants", "/admin/policies"],
+}
+
+ADMIN_VISITS = [
+    ("/admin/users", "Users"),
+    ("/admin/roles-and-teams", "Roles and teams"),
+    ("/admin/group-mappings", "Group mappings"),
+    ("/admin/audit", "Audit log"),
+    ("/admin/tool-servers", "Tool servers"),
+    ("/admin/tool-servers?server=acme", "Tool servers"),
+    ("/admin/grants", "Grants"),
+    ("/admin/policies", "Policies"),
+]
+
+
+def shot_name(role: str, path: str, suffix: str = "") -> str:
+    slug = re.sub(r"[^a-z0-9]+", "-", path.replace("?server=", "/").lower()).strip("-")
+    return f"{role}-{slug or 'home'}{suffix}.png"
+
+
+def png_height(path: Path) -> int:
+    with path.open("rb") as handle:
+        header = handle.read(24)
+    return struct.unpack(">II", header[16:24])[1]
+
+
+def see(locator):
+    def wait(_page: Page) -> None:
+        expect(locator).to_be_visible()
+
+    return wait
+
+
+def region(page: Page, name: str):
+    return page.get_by_role("region", name=name, exact=True)
+
+
+class Visual:
+    def __init__(self, page: Page, role: str, display_name: str | None = None) -> None:
+        self.page = page
+        self.role = role
+        self.display_name = display_name
+        self.csp = watch_csp(page)
+        self.shots: list[str] = []
+
+    def loaded(self, ready) -> None:
+        banner = self.page.get_by_role("banner")
+        if self.display_name is None:
+            expect(
+                banner.get_by_role("navigation", name="Main", exact=True)
+            ).to_be_visible()
+        else:
+            expect(banner).to_contain_text(f"Signed in as {self.display_name}")
+        ready(self.page)
+        expect(
+            self.page.locator("main").get_by_text(LOADING).filter(visible=True)
+        ).to_have_count(0)
+
+    def settle(self) -> None:
+        toasts = self.page.locator(".ui-toasts .ui-toast")
+        try:
+            expect(toasts).to_have_count(0, timeout=8000)
+        except AssertionError:
+            pass
+        for toast in toasts.all():
+            toast.get_by_role("button", name="Dismiss", exact=True).click()
+        expect(toasts).to_have_count(0)
+        assert_layout(self.page, MAX_BANNER_PX)
+        assert_accessible(self.page)
+
+    def shoot(self, path: str, suffix: str = "") -> None:
+        VISUAL_DIR.mkdir(parents=True, exist_ok=True)
+        self.page.evaluate("window.scrollTo(0, 0)")
+        scroll_height = self.page.evaluate("document.documentElement.scrollHeight")
+        name = shot_name(self.role, path, suffix)
+        target = VISUAL_DIR / name
+        self.page.screenshot(path=str(target), full_page=True)
+        assert target.is_file(), name
+        assert target.stat().st_size > 0, name
+        assert png_height(target) >= scroll_height - 1, name
+        self.shots.append(name)
+
+    def check(self, path: str, ready, suffix: str = "") -> None:
+        self.loaded(ready)
+        self.settle()
+        self.shoot(path, suffix)
+
+
+def open_visual(
+    page: Page,
+    role: str,
+    viewport: dict[str, int],
+    display_name: str | None = None,
+) -> Visual:
+    page.set_viewport_size(viewport)
+    return Visual(page, role, display_name)
+
+
+def ready_home_empty(page: Page) -> None:
+    expect(page.get_by_role("status")).to_have_text("Engine healthy")
+    expect(region(page, "Recent runs")).to_contain_text("No runs yet")
+    expect(region(page, "Recent flows")).to_contain_text("No flows yet")
+    expect(
+        region(page, "Next steps").get_by_role(
+            "link", name="Create your first flow", exact=True
+        )
+    ).to_be_visible()
+
+
+def ready_flows(page: Page) -> None:
+    expect(page.get_by_text("No flows yet", exact=True)).to_be_visible()
+
+
+def ready_flow(page: Page) -> None:
+    expect(
+        region(page, "Test run").get_by_role(
+            "button", name="Answers for pay", exact=True
+        )
+    ).to_be_visible()
+
+
+def ready_answers(page: Page) -> None:
+    expect(
+        region(page, "Test run").get_by_role(
+            "textbox", name="Output 1 for pay", exact=True
+        )
+    ).to_be_visible()
+
+
+def ready_run(page: Page) -> None:
+    expect(page.get_by_role("list", name="Steps", exact=True)).to_be_visible()
+
+
+def ready_runs(page: Page) -> None:
