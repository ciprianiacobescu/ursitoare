{"ts": "2026-11-24T15:00:40.826133Z", "run_id": "r-20261124T1454Z-d23f", "unit": "openspec:add-web-tools", "seq": 17, "type": "held.replayed", "question": "Q-001", "task": "2.2", "check": "pre_satisfied", "patch_sha256": "5dd7895ebbdd65857dacd6e36c2eebdcaf09be4d3a9427814f695a9c4066fa91", "tests": ["web.src.tools.servers-call.test.ts::C-0f038efb cursorPageFetcher lists servers of every adapter", "web.src.tools.servers-call.test.ts::C-0f038efb parseToolServer reads a tool with a call and no http as http null", "web.src.tools.servers-call.test.ts::C-0f038efb parseToolServer refuses a present http that is not a method and path"], "sources": {"web.src.tools.servers-call.test.ts::C-0f038efb cursorPageFetcher lists servers of every adapter": "test(\"C-0f038efb cursorPageFetcher lists servers of every adapter\", async () => {\n  const client = {\n    get: (): Promise<never> =>\n      Promise.resolve({ items: [S_FIX, S_MCP, S_CODE], next_cursor: null } as never),\n  };\n  const fetchPage = cursorPageFetcher(client, \"/tool-servers\", { parseItem: parseToolServer });\n  const page = await fetchPage({\n    cursor: null,\n    limit: 50,\n    signal: new AbortController().signal,\n  });\n  assert.deepEqual(\n    page.items.map((s) => s.id),\n    [\"acme\", \"crm\", \"snips\"],\n  );\n  assert.equal(page.next_cursor, null);\n});", "web.src.tools.servers-call.test.ts::C-0f038efb parseToolServer reads a tool with a call and no http as http null": "test(\"C-0f038efb parseToolServer reads a tool with a call and no http as http null\", () => {\n  const mcp = parseToolServer(S_MCP);\n  assert.ok(mcp !== null);\n  assert.deepEqual(mcp.tools, [\n    {\n      name: \"find_vendor\",\n      effect: \"write\",\n      ref: null,\n      untrusted_result: true,\n      unsafe_to_retry: true,\n      http: null,\n    },\n  ]);\n  assert.deepEqual(toolRows(mcp).map((r) => r.call), [\"—\"]);\n  const code = parseToolServer(S_CODE);\n  assert.ok(code !== null);\n  assert.deepEqual(code.tools, [\n    {\n      name: \"word_count\",\n      effect: \"read\",\n      ref: null,\n      untrusted_result: false,\n      unsafe_to_retry: false,\n      http: null,\n    },\n  ]);\n  assert.deepEqual(toolRows(code).map((r) => r.call), [\"—\"]);\n});", "web.src.tools.servers-call.test.ts::C-0f038efb parseToolServer refuses a present http that is not a method and path": "test(\"C-0f038efb parseToolServer refuses a present http that is not a method and path\", () => {\n  const bad = server(\n    \"crm\",\n    \"mcp\",\n    \"https://mcp.fake.test\",\n    { name: \"find_vendor\", effect: \"write\" },\n    { tools: [mcpTool({ http: { method: \"POST\" } })] },\n  );\n  assert.equal(parseToolServer(bad), null);\n});"}, "phase": "red", "attempt": 3}
