+interface StepRig {
+  log: string[];
+  ops: MemoryWorkflowOps;
+  step: () => string;
+  services: (effects: EffectGate, invoker: ToolInvoker) => NodeServices;
+}
+
+function stepRig(): StepRig {
+  const log: string[] = [];
+  const base = memoryWorkflowOps("r_1");
+  let current = "";
+  const ops: WorkflowOps = {
+    get workflowId() {
+      return base.workflowId;
+    },
+    async runStep<T extends JsonValue>(name: string, fn: () => Promise<T>): Promise<T> {
+      return base.runStep(name, async () => {
+        const previous = current;
+        current = name;
+        try {
+          return await fn();
+        } finally {
+          current = previous;
+        }
+      });
+    },
+    sleep: (ms) => base.sleep(ms),
+  };
+  return {
+    log,
+    ops: base,
+    step: () => current,
+    services: (effects, invoker) => ({
+      ops,
+      invoker,
+      effects,
+      resolve: () => PAY_ARGS,
+      block: (ref) => CATALOGUE.block(ref),
+    }),
+  };
+}
+
+function stepLoggingGate(
+  log: string[],
+  step: () => string,
+  decision: EffectDecision,
+): EffectGate {
+  return {
+    async before(call, ctx) {
+      log.push(`${step()}: before ${JSON.stringify([call, ctx])}`);
+      return decision;
+    },
+    async after(call, ctx, result) {
+      log.push(`${step()}: after ${JSON.stringify([call, ctx, result])}`);
+    },
+  };
+}
+
+function stepLoggingInvoker(
+  log: string[],
+  step: () => string,
+  answer: ToolResult,
+): ToolInvoker {
+  return {
+    async invoke(call, ctx) {
+      log.push(`${step()}: invoke ${JSON.stringify([call, ctx])}`);
+      return answer;
+    },
+  };
+}
+
