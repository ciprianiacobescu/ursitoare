+const FORBID =
+  '@id("t-pay-needs-approval") forbid (principal, action == Action::"invoke_tool", resource is Block) when { context.tool == Tool::"tenant_a/acme.create_payment@1" && context.args has "amount" && context.args["amount"].greaterThan(decimal("1000.0000")) } unless { context.approvers_by_role has "approver" && !context.approvers_by_role["approver"].isEmpty() };';
