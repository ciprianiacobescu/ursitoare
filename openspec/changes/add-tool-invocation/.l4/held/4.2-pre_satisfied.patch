+const HOOK_OK =
+  '@id("t-hook-send-ok") permit (principal in Role::"author", action == Action::"invoke_tool", resource is Block) when { resource.kind == "hook" && context.tool == Tool::"tenant_a/acme.post_message@1" };';
+
+// A stub's "not implemented" error must surface as an assertion failure, not a bare error.
+async function settled<T>(what: string, fn: () => Promise<T>): Promise<T> {
+  let value: T | undefined;
+  let done = false;
+  await assert.doesNotReject(async () => {
+    value = await fn();
+    done = true;
+  }, what);
+  assert.ok(done, `${what} resolved`);
+  return value as T;
+}
+
+function finalRowOf(steps: readonly StepRecord[], nodeId: string): StepRecord | undefined {
+  let found: StepRecord | undefined;
+  for (const step of steps) {
+    if (step.nodeId === nodeId) {
+      found = step;
+    }
+  }
+  return found;
+}
+
+async function stepRows(h: InvokeHarness, runId: string): Promise<readonly StepRecord[]> {
+  const store = createRunStore(h.pool);
+  const listed = await settled("the run steps are listed", () =>
+    store.listSteps(h.ctx, runId, { limit: 50 }),
+  );
+  return listed.steps;
+}
+
+function ctxOf(
+  runId: string,
+  nodeId: string,
+  effect: string,
+  extra: Record<string, unknown> = {},
+): StepContext {
+  return {
+    tenant: TENANT_A,
+    runId,
+    lineageId: runId,
+    flowId: "read-then-pay",
+    flowHash: "sha256:" + "e".repeat(64),
+    nodeId,
+    kind: "block",
+    mode: "live",
+    attempt: 1,
+    effect,
+    unsafeToRetry: false,
+    idemKey: null,
+    principal: { userId: "alice", kind: "human" },
+    now: new Date(T0),
+    ...extra,
+  } as unknown as StepContext;
+}
+
+function payCall(amount: number, reference = "inv-1"): ToolCall {
+  return {
+    tool: "acme.create_payment@1",
+    args: { vendor_id: "V-ACME", amount, currency: "EUR", reference },
+    nodeId: "pay",
+    effectSeq: 1,
+  };
+}
+
+async function assertDenied(
+  p: Promise<unknown>,
+  node: string,
+  reason: string,
+  extra: Record<string, string> = {},
+): Promise<Record<string, string>> {
+  const found: Record<string, string> = {};
+  await assert.rejects(p, (e: unknown) => {
+    const err = e as { code?: unknown; message?: unknown; node?: unknown; details?: unknown };
+    assert.equal(err.code, "INTERPRETER_TOOL_DENIED");
+    assert.equal(err.message, `tool call of "${node}" is not permitted (${reason})`);
+    assert.equal(err.node, node);
+    const details = err.details as Record<string, string> | undefined;
+    assert.ok(details !== undefined, "the denial carries details");
+    assert.equal(details["reason"], reason);
+    for (const [key, value] of Object.entries(extra)) {
+      assert.equal(details[key], value);
+    }
+    for (const [key, value] of Object.entries(details)) {
+      found[key] = value;
+    }
+    return true;
+  });
+  return found;
+}
+
+function assertAllowRow(
+  row: PolicyDecisionRecord,
+  node: string,
+  reasons: readonly string[],
+  permit: unknown,
+): void {
+  assert.equal(row.nodeId, node);
+  assert.equal(row.decision, "allow");
+  assert.deepEqual(row.reasons, reasons);
+  assert.deepEqual(row.errors, []);
+  assert.deepEqual(row.permit, permit);
+}
+
+function assertDenyRow(
+  row: PolicyDecisionRecord,
+  node: string,
+  reasons: readonly string[],
+): void {
+  assert.equal(row.nodeId, node);
+  assert.equal(row.decision, "deny");
+  assert.deepEqual(row.reasons, reasons);
+  assert.deepEqual(row.errors, []);
+  assert.equal(row.permit, null);
+}
+
+function assertRunFailed(
+  run: RunRecord,
+  node: string,
+  reason: string,
+  decisionId: string,
+  hook?: string,
+): void {
+  const details: Record<string, string> = { reason, decisionId };
+  if (hook !== undefined) {
+    details["hook"] = hook;
+  }
+  assert.equal(run.state, "failed");
+  assert.deepEqual(run.error, {
+    code: "INTERPRETER_TOOL_DENIED",
+    message: `tool call of "${node}" is not permitted (${reason})`,
+    node,
+    details,
+  });
+}
+
+async function grantAll(h: InvokeHarness): Promise<readonly GrantRecord[]> {
+  const grants: GrantRecord[] = [];
+  for (const tool of G_ALL_TOOLS) {
+    grants.push(
+      await settled("a G_ALL grant is created", () =>
+        h.grant({ subject: { kind: "role", role: "author" }, tool, scope: { kind: "any_step" }, args: [] }),
+      ),
+    );
+  }
+  return grants;
+}
