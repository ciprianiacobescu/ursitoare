+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import type { StepContext, ToolCall } from "../../interpreter/index.ts";
+import type { PolicyRuntime } from "../../grants/index.ts";
+import type { PolicyDecisionRecord, PolicyRequest } from "../../pdp/index.ts";
+import { createRunStore } from "../../runs/index.ts";
+import type { RunRecord, StepRecord } from "../../runs/index.ts";
+import { invokeHarness } from "../../../test/support/invoke-runs/harness.ts";
+import type { HarnessWrap, InvokeHarness } from "../../../test/support/invoke-runs/harness.ts";
+
+const T0 = "2026-11-06T10:00:00.000Z";
+const INPUT = { vendor_name: "Acme GmbH", amount: 12.5 };
+const PAY_IDEM_KEY_HOOK = "ik1_b67e1caff43c8cbc2b72758a1870219a8375cace7325d2fd5ae425acb8701828";
+
+const G_LOOKUP = {
+  subject: { kind: "role", role: "author" },
+  tool: "acme.lookup_vendor@1",
+  scope: { kind: "any_step" },
+  args: [],
+};
+
+const G_PAY = {
+  subject: { kind: "role", role: "author" },
+  tool: "acme.create_payment@1",
+  scope: { kind: "node", flowId: "read-then-pay", nodeId: "pay" },
+  args: [],
+};
+
+const G_PAYH = {
+  ...G_PAY,
+  scope: { kind: "node", flowId: "hooked-pay", nodeId: "pay" },
+};
+
+const ALL_TOOLS = [
+  "acme.lookup_vendor@1",
+  "acme.create_payment@1",
+  "acme.get@1",
+  "acme.flag_vendor@1",
+  "acme.post_message@1",
+];
+
+const FORBID =
+  '@id("t-pay-needs-approval") forbid (principal, action == Action::"invoke_tool", resource is Block) when { context.tool == Tool::"tenant_a/acme.create_payment@1" && context.args has "amount" && context.args["amount"].greaterThan(decimal("1000.0000")) } unless { context.approvers_by_role has "approver" && !context.approvers_by_role["approver"].isEmpty() };';
+
+const HOOK_OK =
+  '@id("t-hook-send-ok") permit (principal in Role::"author", action == Action::"invoke_tool", resource is Block) when { resource.kind == "hook" && context.tool == Tool::"tenant_a/acme.post_message@1" };';
+
+const PAY: ToolCall = {
+  tool: "acme.create_payment@1",
+  args: { vendor_id: "V-ACME", amount: 2450, currency: "EUR", reference: "inv-1" },
+  nodeId: "pay",
+  effectSeq: 0,
+};
+
+// A stub's "not implemented" error must surface as an assertion failure, not a bare error.
+async function settled<T>(what: string, fn: () => Promise<T>): Promise<T> {
+  let value: T | undefined;
+  let done = false;
+  await assert.doesNotReject(async () => {
+    value = await fn();
+    done = true;
+  }, what);
+  assert.ok(done, `${what} resolved`);
+  return value as T;
+}
+
+function openHarness(wrap?: HarnessWrap): Promise<InvokeHarness> {
+  return settled("invokeHarness resolves", () => invokeHarness(wrap));
+}
+
+function finalRowOf(steps: readonly StepRecord[], nodeId: string): StepRecord | undefined {
+  let found: StepRecord | undefined;
+  for (const step of steps) {
+    if (step.nodeId === nodeId) {
+      found = step;
+    }
+  }
+  return found;
+}
+
+async function stepsOf(h: InvokeHarness, runId: string): Promise<readonly StepRecord[]> {
+  const store = createRunStore(h.pool);
+  const listed = await settled("the run steps are listed", () =>
+    store.listSteps(h.ctx, runId, { limit: 50 }),
+  );
+  return listed.steps;
+}
+
+function decisionIds(rows: readonly PolicyDecisionRecord[]): string[] {
+  return rows.map((r) => r.decisionId);
+}
+
+function ctxOf(runId: string, taint: readonly string[] | undefined, approvals: unknown): StepContext {
+  const base = {
+    tenant: { tenantId: "tenant_a", reviewProfile: "solo" },
+    runId,
+    lineageId: runId,
+    flowId: "read-then-pay",
+    flowHash: "sha256:" + "e".repeat(64),
+    nodeId: "pay",
+    kind: "block",
+    mode: "live",
+    attempt: 1,
+    effect: "pay",
+    unsafeToRetry: false,
+    idemKey: null,
+    principal: { userId: "alice", kind: "human" },
+    now: new Date(T0),
+  };
+  return {
+    ...base,
+    ...(taint === undefined ? {} : { taint }),
+    ...(approvals === undefined ? {} : { approvals }),
+  } as unknown as StepContext;
+}
+
+async function authorizeFor(
+  h: InvokeHarness,
+  runId: string,
+  taint: readonly string[] | undefined,
+  approvals: unknown,
+  amount: number = 12.5,
+): Promise<{ allowed: boolean; decisionId: string }> {
+  const run: RunRecord = await settled("h.start resolves", () =>
+    h.start("H1", { ...INPUT, amount }, runId),
+  );
+  const inv = await settled("liveInvoker resolves", () => h.path.liveInvoker(run));
+  assert.ok(inv.authorize !== undefined, "the live invoker has authorize");
+  const call: ToolCall = { ...PAY, args: { ...PAY.args, amount } as ToolCall["args"] };
+  try {
+    const granted = await inv.authorize(call, ctxOf(runId, taint, approvals));
+    return { allowed: true, decisionId: granted.decisionId };
+  } catch (e) {
+    const err = e as { code?: unknown; details?: { decisionId?: unknown } };
+    assert.equal(err.code, "INTERPRETER_TOOL_DENIED");
+    return { allowed: false, decisionId: String(err.details?.decisionId) };
+  }
+}
+
+test("C-9baab7e2 an ungranted pay is denied in a run with nothing sent", async () => {
+  const h = await openHarness();
+  try {
+    await settled("grant", () => h.grant(G_LOOKUP));
+    await settled("deploy", () => h.deploy(""));
+    const run = await settled("h.run resolves", () => h.run("H1", INPUT, "r_2"));
+    assert.equal(run.state, "failed");
+
+    const rows = await h.decisions("r_2");
+    assert.deepEqual(
+      rows.map((r) => [r.nodeId, r.decision]),
+      [
+        ["lookup", "allow"],
+        ["pay", "deny"],
+      ],
+    );
+    const deny = rows[1];
+    assert.ok(deny !== undefined);
+    assert.deepEqual(deny.reasons, []);
+    assert.deepEqual(deny.errors, []);
+    assert.equal(deny.permit, null);
+    assert.deepEqual(run.error, {
+      code: "INTERPRETER_TOOL_DENIED",
+      message: 'tool call of "pay" is not permitted (policy)',
+      node: "pay",
+      details: { reason: "policy", decisionId: deny.decisionId },
+    });
+
+    const payRow = finalRowOf(await stepsOf(h, "r_2"), "pay");
+    assert.ok(payRow !== undefined);
+    assert.equal(payRow.state, "failed");
+    assert.equal(payRow.policyDecisionId, deny.decisionId);
+    assert.equal(await h.intents("r_2"), 0);
+    assert.equal(h.tools.calls().length, 1);
+    assert.deepEqual(
+      h.gateway.calls.map((c) => (c as { op: string }).op),
+      ["requestToken", "send"],
+    );
+  } finally {
+    await h.close();
+  }
+});
+
+test("C-9b030af8 a policy error at pay fails the run", async () => {
+  const policy: NonNullable<HarnessWrap["policy"]> = (real) =>
+    ({
+      engine: Object.assign(Object.create(real.engine) as object, {
+        check: async (req: PolicyRequest) => {
+          if (!JSON.stringify(req.resource).includes("/pay")) {
+            return real.engine.check(req);
+          }
+          return {
+            decision: "deny",
+            decisionId: "dec_e6",
+            decidedAt: T0,
+            reasons: [],
+            errors: ["POLICY_SET_UNAVAILABLE"],
+            policySetVersion: real.engine.policySetVersion,
+          };
+        },
+      }),
+      toolArgs: (tenantId: string) => real.toolArgs(tenantId),
+      reload: (tenantId: string) => real.reload(tenantId),
+    }) as unknown as PolicyRuntime;
+  const h = await openHarness({ policy });
+  try {
+    await settled("grant", () => h.grant(G_LOOKUP));
+    await settled("deploy", () => h.deploy(""));
+    const run = await settled("h.run resolves", () => h.run("H1", INPUT, "r_8"));
+    assert.equal(run.state, "failed");
+    assert.deepEqual(run.error, {
+      code: "INTERPRETER_TOOL_DENIED",
+      message: 'tool call of "pay" is not permitted (policy_error)',
+      node: "pay",
+      details: { reason: "policy_error", decisionId: "dec_e6", errorCount: "1" },
+    });
+    assert.ok(!JSON.stringify(run.error).includes("POLICY_SET_UNAVAILABLE"));
+
+    const rows = await h.decisions("r_8");
+    assert.deepEqual(
+      rows.map((r) => [r.nodeId, r.decision]),
+      [
+        ["lookup", "allow"],
+        ["pay", "deny"],
+      ],
+    );
+    assert.equal(rows[1]?.decisionId, "dec_e6");
+    const payRow = finalRowOf(await stepsOf(h, "r_8"), "pay");
+    assert.ok(payRow !== undefined);
+    assert.equal(payRow.state, "failed");
+    assert.equal(payRow.policyDecisionId, "dec_e6");
+    assert.equal(await h.intents("r_8"), 0);
+    assert.equal(h.tools.calls().length, 1);
+    assert.deepEqual(
+      h.gateway.calls.map((c) => (c as { op: string }).op),
+      ["requestToken", "send"],
+    );
+  } finally {
+    await h.close();
+  }
+});
