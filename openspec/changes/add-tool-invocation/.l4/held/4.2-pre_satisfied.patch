+    const payStep = finalRowOf(await stepRows(h, "r_8"), "pay");
+    assert.ok(payStep !== undefined, "the pay row exists");
+    assert.equal(payStep.state, "failed");
+    assert.equal(payStep.policyDecisionId, "dec_e6");
