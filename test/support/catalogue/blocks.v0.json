{
  "catalogue": "ursitoare-blocks",
  "version": "0.1.0",
  "notes": "Closed block vocabulary for Phase-0 spikes. effect: read (no side effects) | write | send | pay (consequential). trust on outputs: 'untrusted' marks fields carrying third-party content (taint source). Mock implementations live in shared/mocks/mock-tools.",
  "blocks": {
    "invoices.get@1": {
      "effect": "read",
      "description": "Fetch an incoming invoice by id.",
      "data_class": "private",
      "input": {"type": "object", "properties": {"invoice_id": {"type": "string"}}, "required": ["invoice_id"]},
      "output": {"type": "object", "properties": {"invoice_id": {"type": "string"}, "vendor_name": {"type": "string"}, "raw_text": {"type": "string"}, "received_at": {"type": "string"}}, "required": ["invoice_id", "raw_text"]},
      "untrusted_fields": ["raw_text", "vendor_name"]
    },
    "docs.fetch@1": {
      "effect": "read",
      "description": "Fetch a document or web page by URL.",
      "data_class": "public",
      "input": {"type": "object", "properties": {"url": {"type": "string"}}, "required": ["url"]},
      "output": {"type": "object", "properties": {"content": {"type": "string"}, "content_type": {"type": "string"}}, "required": ["content"]},
      "untrusted_fields": ["content"]
    },
    "mail.read_inbox@1": {
      "effect": "read",
      "description": "Read recent messages from a mailbox.",
      "data_class": "private",
      "input": {"type": "object", "properties": {"mailbox": {"type": "string"}, "max": {"type": "integer"}}, "required": ["mailbox"]},
      "output": {"type": "object", "properties": {"messages": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "from": {"type": "string"}, "subject": {"type": "string"}, "body": {"type": "string"}}, "required": ["id", "from", "subject", "body"]}}}, "required": ["messages"]},
      "untrusted_fields": ["messages"]
    },
    "http.get@1": {
      "effect": "read",
      "description": "HTTP GET an allowlisted URL through the gateway.",
      "data_class": "public",
      "input": {"type": "object", "properties": {"url": {"type": "string"}}, "required": ["url"]},
      "output": {"type": "object", "properties": {"status": {"type": "integer"}, "body": {"type": "string"}}, "required": ["status", "body"]},
      "untrusted_fields": ["body"]
    },
    "erp.lookup_vendor@1": {
      "effect": "read",
      "description": "Look up a vendor in the ERP by name.",
      "data_class": "private",
      "input": {"type": "object", "properties": {"vendor_name": {"type": "string"}}, "required": ["vendor_name"]},
      "output": {"type": "object", "properties": {"vendor_id": {"type": "string"}, "status": {"type": "string", "enum": ["active", "blocked"]}, "payment_terms_days": {"type": "integer"}}, "required": ["vendor_id", "status"]}
    },
    "crm.find_customer@1": {
      "effect": "read",
      "description": "Find a customer by email.",
      "data_class": "private",
      "input": {"type": "object", "properties": {"email": {"type": "string"}}, "required": ["email"]},
      "output": {"type": "object", "properties": {"customer_id": {"type": "string"}, "name": {"type": "string"}, "tier": {"type": "string", "enum": ["gold", "silver", "bronze"]}}, "required": ["customer_id", "tier"]}
    },
    "orders.get@1": {
      "effect": "read",
      "description": "Get an order by id.",
      "data_class": "private",
      "input": {"type": "object", "properties": {"order_id": {"type": "string"}}, "required": ["order_id"]},
      "output": {"type": "object", "properties": {"order_id": {"type": "string"}, "customer_email": {"type": "string"}, "total": {"type": "number"}, "currency": {"type": "string"}, "status": {"type": "string", "enum": ["placed", "shipped", "delivered", "cancelled"]}}, "required": ["order_id", "customer_email", "total", "status"]}
    },
    "kb.search@1": {
      "effect": "read",
      "description": "Search the internal knowledge base (trusted, curated content).",
      "data_class": "public",
      "input": {"type": "object", "properties": {"query": {"type": "string"}, "top_k": {"type": "integer"}}, "required": ["query"]},
      "output": {"type": "object", "properties": {"passages": {"type": "array", "items": {"type": "object", "properties": {"text": {"type": "string"}, "source": {"type": "string"}}, "required": ["text", "source"]}}}, "required": ["passages"]}
    },
    "calendar.find_slots@1": {
      "effect": "read",
      "description": "Find free meeting slots for attendees.",
      "data_class": "private",
      "input": {"type": "object", "properties": {"attendees": {"type": "array", "items": {"type": "string"}}, "duration_minutes": {"type": "integer"}}, "required": ["attendees", "duration_minutes"]},
      "output": {"type": "object", "properties": {"slots": {"type": "array", "items": {"type": "object", "properties": {"start": {"type": "string"}, "end": {"type": "string"}}, "required": ["start", "end"]}}}, "required": ["slots"]}
    },
    "erp.create_payment@1": {
      "effect": "pay",
      "description": "Create a vendor payment. Idempotent on the engine-supplied idempotency key.",
      "input": {"type": "object", "properties": {"vendor_id": {"type": "string"}, "amount": {"type": "number"}, "currency": {"type": "string"}, "reference": {"type": "string"}}, "required": ["vendor_id", "amount", "currency", "reference"]},
      "output": {"type": "object", "properties": {"payment_id": {"type": "string"}, "status": {"type": "string"}}, "required": ["payment_id", "status"]}
    },
    "orders.refund@1": {
      "effect": "pay",
      "description": "Refund an order fully or partially.",
      "input": {"type": "object", "properties": {"order_id": {"type": "string"}, "amount": {"type": "number"}, "reason": {"type": "string"}}, "required": ["order_id", "amount", "reason"]},
      "output": {"type": "object", "properties": {"refund_id": {"type": "string"}, "status": {"type": "string"}}, "required": ["refund_id", "status"]}
    },
    "mail.send@1": {
      "effect": "send",
      "description": "Send an email.",
      "input": {"type": "object", "properties": {"to": {"type": "string"}, "subject": {"type": "string"}, "body": {"type": "string"}}, "required": ["to", "subject", "body"]},
      "output": {"type": "object", "properties": {"message_id": {"type": "string"}}, "required": ["message_id"]}
    },
    "slack.post_message@1": {
      "effect": "send",
      "description": "Post a message to a Slack channel.",
      "input": {"type": "object", "properties": {"channel": {"type": "string"}, "text": {"type": "string"}}, "required": ["channel", "text"]},
      "output": {"type": "object", "properties": {"ts": {"type": "string"}}, "required": ["ts"]}
    },
    "http.post@1": {
      "effect": "send",
      "description": "HTTP POST JSON to an allowlisted URL through the gateway.",
      "input": {"type": "object", "properties": {"url": {"type": "string"}, "json": {"type": "object"}}, "required": ["url", "json"]},
      "output": {"type": "object", "properties": {"status": {"type": "integer"}, "body": {"type": "string"}}, "required": ["status", "body"]},
      "untrusted_fields": ["body"]
    },
    "crm.create_ticket@1": {
      "effect": "write",
      "description": "Create a support ticket.",
      "input": {"type": "object", "properties": {"customer_id": {"type": "string"}, "subject": {"type": "string"}, "priority": {"type": "string", "enum": ["low", "normal", "high", "urgent"]}, "body": {"type": "string"}}, "required": ["customer_id", "subject", "priority", "body"]},
      "output": {"type": "object", "properties": {"ticket_id": {"type": "string"}}, "required": ["ticket_id"]}
    },
    "crm.update_ticket@1": {
      "effect": "write",
      "description": "Update a ticket's status and add a note.",
      "input": {"type": "object", "properties": {"ticket_id": {"type": "string"}, "status": {"type": "string", "enum": ["open", "pending", "solved", "closed"]}, "note": {"type": "string"}}, "required": ["ticket_id", "status"]},
      "output": {"type": "object", "properties": {"ticket_id": {"type": "string"}, "status": {"type": "string"}}, "required": ["ticket_id", "status"]}
    },
    "sheets.append_row@1": {
      "effect": "write",
      "description": "Append a row to a spreadsheet.",
      "input": {"type": "object", "properties": {"sheet_id": {"type": "string"}, "values": {"type": "array", "items": {"type": "string"}}}, "required": ["sheet_id", "values"]},
      "output": {"type": "object", "properties": {"row": {"type": "integer"}}, "required": ["row"]}
    },
    "calendar.create_event@1": {
      "effect": "write",
      "description": "Create a calendar event.",
      "input": {"type": "object", "properties": {"title": {"type": "string"}, "start": {"type": "string"}, "end": {"type": "string"}, "attendees": {"type": "array", "items": {"type": "string"}}}, "required": ["title", "start", "end", "attendees"]},
      "output": {"type": "object", "properties": {"event_id": {"type": "string"}}, "required": ["event_id"]}
    },
    "docs.create@1": {
      "effect": "write",
      "description": "Create an internal document.",
      "input": {"type": "object", "properties": {"title": {"type": "string"}, "content": {"type": "string"}}, "required": ["title", "content"]},
      "output": {"type": "object", "properties": {"doc_id": {"type": "string"}, "url": {"type": "string"}}, "required": ["doc_id", "url"]}
    },
    "erp.flag_vendor@1": {
      "effect": "write",
      "description": "Flag a vendor for compliance review.",
      "input": {"type": "object", "properties": {"vendor_id": {"type": "string"}, "reason": {"type": "string"}}, "required": ["vendor_id", "reason"]},
      "output": {"type": "object", "properties": {"flag_id": {"type": "string"}}, "required": ["flag_id"]}
    }
  },
  "model_profiles": ["default", "fast", "careful"],
  "roles": ["tenant_admin", "author", "approver", "auditor"],
  "delegate_targets": {"n8n": ["archive-invoice", "sync-crm", "generate-report"]},
  "flows_registry": {"notify-customer@1": {"inputs": {"type": "object", "properties": {"customer_id": {"type": "string"}, "message": {"type": "string"}}, "required": ["customer_id", "message"]}, "outputs": {"type": "object", "properties": {"delivered": {"type": "boolean"}}, "required": ["delivered"]}}}
}
